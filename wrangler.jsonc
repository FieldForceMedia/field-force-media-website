{
  "name": "field-force-media",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "bash build.sh" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "fieldforcemedia.com", "custom_domain": true },
    { "pattern": "www.fieldforcemedia.com", "custom_domain": true }
  ]
}
